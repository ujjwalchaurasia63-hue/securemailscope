# =====================================================================
# SecureMailScope — Environment Configuration (Optional)
# =====================================================================
# All settings below have sensible defaults and are optional.

# Path to system TShark binary if not in standard installation directories or PATH
# Standard Windows path: C:\Program Files\Wireshark\tshark.exe
# Standard Linux/macOS path: /usr/bin/tshark
# TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe

# Streamlit Local Server Configuration
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
# STREAMLIT_SERVER_HEADLESS=true
